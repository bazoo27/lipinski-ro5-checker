# Gets properties from the chem.csv and adds them to a dictionary for each molecule!

def get_properties(smiles):

    mol = Chem.MolFromSmiles(smiles)

    properties = {
        "smiles": smiles,
        "mol_weight": Descriptors.MolWt(mol),
        "logp": Descriptors.MolLogP(mol),
        "h_donors": Descriptors.NumHDonors(mol),
        "h_acceptors": Descriptors.NumHAcceptors(mol),
        "tpsa": Descriptors.TPSA(mol),
    }

    return properties


def lipinski_check(properties):
    rules = [
            ("mol_weight", 500, "Molecular weight too high (>500)"),
            ("logp", 5, "LogP too high (>5)"),
            ("h_donors", 5, "Too many H-bond donors (>5)"),
            ("h_acceptors", 10, "Too many H-bond acceptors (>10)"),
            ("tpsa", 140, "TPSA too high (>140)"),
         ]

    violations = [msg for key, limit, msg in rules if properties.get(key, 0) > limit]

    for msg in violations:
        print(msg)
    

    if not violations:
        print("This molecule passes all the Lipinski rules")
    else:
        print(f"This molecule passes {len(rules) - len(violations)} tests but fails {len(violations)}")

    return violations



def full_breakdown(molecules):
    for name, smiles in molecules.items():
        mol = Chem.MolFromSmiles(smiles)
        if mol is None:
            print(f"{name}: invalid SMILES - {smiles}")
            continue
        print(name, "->", mol.GetNumAtoms(), "heavy atoms")
        print(get_properties(smiles))
        lipinski_check(get_properties(smiles))


def minione(molecules):
    for name, smiles in molecules.items():
        mol = Chem.MolFromSmiles(smiles)
        if mol is None:
            print(f"{name}: invalid SMILES - {smiles}")
            continue
        print(name)
        print(smiles)
        lipinski_check(get_properties(smiles))



